<Window x:Class="IdleGuard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IdleGuard.Models"
    Title="IdleGuard — 设备与空闲计时">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootLayout" Background="Transparent">
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBarArea" Background="Transparent" Padding="16,0,150,0">
        <TextBlock x:Name="WindowTitleText" Text="IdleGuard" VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
      </Grid>
      <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Background="Transparent"
                    VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Text="设备与空闲计时" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="只有勾选设备的有效输入会重置 IdleGuard 的独立计时。" TextWrapping="Wrap" />
            </StackPanel>
            <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock x:Name="IdleText" Text="空闲 0.0 秒" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="MonitorText" TextWrapping="Wrap" />
                <TextBlock x:Name="ActivityText" TextWrapping="Wrap" />
                <TextBlock x:Name="LastAcceptedText" TextWrapping="Wrap" />
                <TextBlock x:Name="CountsText" />
              </StackPanel>
            </Border>
            <Grid>
                <TextBlock Text="键盘与鼠标" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button Content="刷新设备" HorizontalAlignment="Right" Click="RefreshDevices_Click" />
            </Grid>
            <TextBlock Text="默认全部启用。取消勾选后，该设备仍能正常操作电脑，但不会重置这里的计时。选择暂不保存到磁盘。" TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyDevicesText" Text="未发现键鼠设备，请刷新或检查监控状态。" Visibility="Collapsed" TextWrapping="Wrap" />
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:InputDevice">
                            <Border Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="4">
                                    <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Margin="32,0,0,0" />
                                    <TextBlock Text="{x:Bind Path}" Margin="32,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            <TextBlock Text="同一实体设备可能提供多个键鼠接口。当前按 Windows 报告的接口分别显示；手柄尚未接入。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="屏保信息" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="20" RowSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="当前屏保" />
                    <TextBlock x:Name="ScreenSaverText" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Grid.Row="1" Text="系统屏保超时" />
                    <TextBlock x:Name="TimeoutText" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="系统自动屏保" />
                    <TextBlock x:Name="AutomaticText" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="屏保运行状态" />
                    <TextBlock x:Name="RunningText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <TextBlock Text="尚未启用超时自动触发。Windows 自己的屏保计时仍独立工作。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="28,16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="刷新信息" Click="Refresh_Click" />
                <Button x:Name="StartButton" Content="启动屏保" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <TextBlock Text="手动测试：点击后暂时不要操作输入设备，退出屏保后查看检测结果。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ResultText" Text="尚未操作。" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
      </Border>
    </Grid>
</Window>
