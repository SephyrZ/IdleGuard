<Window x:Class="IdleGuard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IdleGuard.Models" Title="IdleGuard">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootLayout" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="24" /><Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" /><Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea" Background="Transparent" Padding="16,0,150,0">
            <TextBlock x:Name="WindowTitleText" Text="IdleGuard" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="224"
            IsPaneOpen="True" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNav" Content="{Binding [Home]}" Tag="home" Icon="Home" />
                <NavigationViewItem Content="{Binding [Devices]}" Tag="devices" Icon="ViewAll" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{Binding [About]}" Tag="about" Icon="Help" />
                <NavigationViewItem Content="{Binding [Settings]}" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="HomePage" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="32,28,32,24" Spacing="20" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8"><TextBlock Text="{Binding [HomeTitle]}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" /><TextBlock Text="{Binding [HomeSubtitle]}" Style="{StaticResource Hint}" /></StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{Binding [TimingTitle]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [TimeoutSource]}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="TimeoutSourceBox" Grid.Column="1" Width="260" AutomationProperties.Name="{Binding [TimeoutSource]}" SelectionChanged="TimeoutSource_Changed">
                                        <ComboBoxItem x:Name="CustomTimeoutItem" /><ComboBoxItem x:Name="SystemTimeoutItem" />
                                    </ComboBox>
                                </Grid>
                                <Grid x:Name="CustomTimeoutRow" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [CustomSeconds]}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <NumberBox x:Name="TimeoutBox" Grid.Column="1" Width="120" AutomationProperties.Name="{Binding [CustomSeconds]}" Minimum="1" Maximum="86400" SpinButtonPlacementMode="Hidden" ValueChanged="Timeout_ValueChanged" />
                                </Grid>
                                <TextBlock x:Name="EffectiveTimeoutText" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [TimingHelp]}" Style="{StaticResource Hint}" />
                                <Button x:Name="MonitoringButton" Content="{Binding [StartMonitoring]}" Click="Monitoring_Click" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding [ScreenSaverTitle]}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{Binding [ConfiguredSaver]}" Style="{StaticResource Hint}" /><TextBlock x:Name="ScreenSaverText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <Grid ColumnSpacing="20" RowSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding [SystemTimeout]}"/><TextBlock x:Name="TimeoutText" Grid.Column="1"/>
                                    <TextBlock Text="{Binding [Automatic]}" Grid.Row="1"/><TextBlock x:Name="AutomaticText" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="{Binding [Running]}" Grid.Row="2"/><TextBlock x:Name="RunningText" Grid.Row="2" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding [CoexistHelp]}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="32,28,32,24" Spacing="20" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8"><TextBlock Text="{Binding [DevicesTitle]}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding [DevicesSubtitle]}" Style="{StaticResource Hint}"/></StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="MonitorText" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [LatestInput]}" Style="{StaticResource Hint}" /><TextBlock x:Name="ActivityText" TextWrapping="Wrap" />
                                <TextBlock x:Name="CountsText" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding [DeviceList]}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [DevicesHelp]}" Style="{StaticResource Hint}" />
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="{Binding [RefreshDevices]}" Click="RefreshDevices_Click" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [ShowDeviceIds]}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ShowDeviceIds" AutomationProperties.Name="{Binding [ShowDeviceIds]}" OffContent="" OnContent="" MinWidth="0" Toggled="ShowDeviceIds_Toggled" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="EmptyDevicesText" Text="{Binding [EmptyDevices]}" Visibility="Collapsed" TextWrapping="Wrap" />
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InputDevice">
                                    <Border Padding="16" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <CheckBox Content="{x:Bind DisplayName, Mode=OneWay}" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                                            <TextBlock Text="{x:Bind Path}" Visibility="{x:Bind ShowId, Mode=OneWay}" Margin="32,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding [InterfacesHelp]}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="32,28,32,24" Spacing="20" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8"><TextBlock Text="{Binding [SettingsTitle]}" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="{Binding [SettingsSubtitle]}" Style="{StaticResource Hint}"/></StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8C1;" FontSize="24" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Language]}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [LanguageHelp]}" Style="{StaticResource Hint}" FontSize="12" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="200" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Language]}" SelectionChanged="Language_Changed">
                                    <ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="English" Tag="en-US" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7E8;" FontSize="24" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [LaunchAtStartup]}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [StartupHelp]}" Style="{StaticResource Hint}" FontSize="12" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" AutomationProperties.Name="{Binding [LaunchAtStartup]}" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center" Toggled="Startup_Toggled" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="StartupErrorText" TextWrapping="Wrap" />
                        <TextBlock x:Name="TrayErrorText" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [SaveHelp]}" Style="{StaticResource Hint}" /><TextBlock x:Name="PreferencesErrorText" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="32,28,32,24" Spacing="20" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding [AboutTitle]}" Style="{StaticResource TitleTextBlockStyle}" />
                        <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
                            <FontIcon Glyph="&#xE7F4;" FontSize="40" HorizontalAlignment="Left" /><TextBlock Text="IdleGuard" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [Version]}" Style="{StaticResource Hint}" /><TextBlock Text="{Binding [AboutDescription]}" TextWrapping="Wrap" /><TextBlock Text="{Binding [AboutScope]}" Style="{StaticResource Hint}" />
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Padding="32,16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock x:Name="IdleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="RemainingText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="1" FontSize="16" VerticalAlignment="Center" AutomationProperties.Name="{Binding [CurrentTime]}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="StartButton" Content="{Binding [Test]}" Click="Start_Click" ToolTipService.ToolTip="{Binding [TestHelp]}" />
                        </StackPanel>
                        <TextBlock x:Name="ControllerStatusText" Grid.Row="1" Style="{StaticResource Hint}" FontSize="12" />
                        <TextBlock x:Name="ResultText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MaxWidth="500" TextTrimming="CharacterEllipsis" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
